<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Agendar evento</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background-color: #f8f9fa; }
    .card { max-width: 600px; margin: 2rem auto; }
    .form-label { font-weight: 500; }
  </style>
</head>
<body>
  <div class="container">
    <div class="card shadow p-4">
      <h2 class="text-center mb-4">📅 Agendar evento</h2>
      <p class="text-muted text-center">Completa los datos para solicitar una reunión.</p>

      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <form method="POST" action="">
        <!-- Título -->
        <div class="mb-3">
          <label for="title" class="form-label">Título *</label>
          <input type="text" class="form-control" id="title" name="title" required
                 value="<%= locals.eventData ? eventData.title : '' %>">
        </div>

        <!-- Descripción -->
        <div class="mb-3">
          <label for="description" class="form-label">Descripción</label>
          <textarea class="form-control" id="description" name="description" rows="2"><%= locals.eventData ? eventData.description : '' %></textarea>
        </div>

        <!-- Fechas -->
        <div class="row">
          <div class="col-md-6 mb-3">
            <label for="start" class="form-label">Inicio *</label>
            <input type="datetime-local" class="form-control" id="start" name="start" required
                   value="<%= locals.eventData ? eventData.start : '' %>">
          </div>
          <div class="col-md-6 mb-3">
            <label for="end" class="form-label">Fin *</label>
            <input type="datetime-local" class="form-control" id="end" name="end" required
                   value="<%= locals.eventData ? eventData.end : '' %>">
          </div>
        </div>

        <!-- Todo el día -->
        <div class="mb-3 form-check">
          <input type="checkbox" class="form-check-input" id="allDay" name="allDay"
                 <%= locals.eventData && eventData.allDay ? 'checked' : '' %>>
          <label class="form-check-label" for="allDay">Todo el día</label>
        </div>

        <button type="submit" class="btn btn-primary w-100">Enviar solicitud</button>
      </form>

      <p class="mt-3 text-center text-muted small">Este enlace caduca en 24 horas.</p>
    </div>
  </div>

  <script>
    // Auto-llenar fin cuando cambia inicio (pero solo si no se ha modificado manualmente)
    let endManuallyChanged = false;
    const startInput = document.getElementById('start');
    const endInput = document.getElementById('end');

    startInput.addEventListener('change', function() {
      if (!endManuallyChanged) {
        endInput.value = this.value;
      }
    });

    endInput.addEventListener('change', function() {
      endManuallyChanged = true;
    });
  </script>
</body>
</html>
