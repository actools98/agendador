<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Agendar evento</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background-color: #f8f9fa; }
    .card { max-width: 600px; margin: 2rem auto; }
    .form-label { font-weight: 500; }
    .day-badge {
      display: inline-block;
      padding: 0.2rem 0.6rem;
      background-color: #e9ecef;
      border-radius: 20px;
      font-size: 0.8rem;
      margin: 0.1rem;
    }
    .hour-select { min-width: 80px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="card shadow p-4">
      <h2 class="text-center mb-4">📅 Agendar reunión</h2>
      <p class="text-muted text-center">Selecciona una fecha y hora dentro de la disponibilidad del anfitrión.</p>

      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <!-- Mostrar información de disponibilidad -->
      <div class="alert alert-info">
        <p class="mb-1"><strong>Disponibilidad:</strong></p>
        <p class="mb-1">
          <span id="availabilityDays"></span>
        </p>
        <p class="mb-0">
          Horario: <span id="availabilityHours"></span>
        </p>
        <p class="mb-0 mt-1">
          Duración estándar: <span id="meetingDurationDisplay"></span>
        </p>
        <% if (locals.contactPhone && contactPhone) { %>
          <p class="mb-0 mt-2">
            <strong>Contacto para cancelaciones:</strong> <%= contactPhone %>
          </p>
        <% } %>
      </div>

      <form method="POST" action="" id="inviteForm">
        <!-- Título -->
        <div class="mb-3">
          <label for="title" class="form-label">Título *</label>
          <input type="text" class="form-control" id="title" name="title" required
                 value="<%= locals.eventData ? eventData.title : '' %>">
        </div>

        <!-- Descripción -->
        <div class="mb-3">
          <label for="description" class="form-label">Descripción</label>
          <textarea class="form-control" id="description" name="description" rows="2"><%= locals.eventData ? eventData.description : '' %></textarea>
        </div>

        <!-- Fecha -->
        <div class="mb-3">
          <label for="dateSelect" class="form-label">Fecha *</label>
          <input type="date" class="form-control" id="dateSelect" name="date" required
                 value="<%= locals.eventData ? eventData.date : '' %>"
                 min="" max="">
        </div>

        <!-- Hora (selector con solo horas permitidas) -->
        <div class="mb-3">
          <label for="hourSelect" class="form-label">Hora de inicio *</label>
          <select class="form-select" id="hourSelect" name="hour" required>
            <option value="">Selecciona una hora</option>
          </select>
          <small class="text-muted">Solo se muestran horas dentro de la franja disponible.</small>
        </div>

        <button type="submit" class="btn btn-primary w-100">Enviar solicitud</button>
      </form>

      <p class="mt-3 text-center text-muted small">Este enlace caduca en 24 horas.</p>
    </div>
  </div>

  <script>
    // Datos desde el servidor
    const availabilityData = <%- JSON.stringify({
      workStart: locals.workStart || 480,
      workEnd: locals.workEnd || 1020,
      workDays: locals.workDays || '1,2,3,4,5',
      meetingDuration: locals.meetingDuration || 60,
      dayNames: ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'],
      contactPhone: locals.contactPhone || ''
    }) %>;

    // Mostrar información de disponibilidad
    const daysMap = {1:'Lun',2:'Mar',3:'Mié',4:'Jue',5:'Vie',6:'Sáb',7:'Dom'};
    const days = availabilityData.workDays.split(',').map(Number);
    const daysText = days.map(d => daysMap[d]).join(', ');
    document.getElementById('availabilityDays').textContent = daysText;

    const startHour = Math.floor(availabilityData.workStart / 60);
    const startMin = availabilityData.workStart % 60;
    const endHour = Math.floor(availabilityData.workEnd / 60);
    const endMin = availabilityData.workEnd % 60;
    const startStr = `${String(startHour).padStart(2, '0')}:${String(startMin).padStart(2, '0')}`;
    const endStr = `${String(endHour).padStart(2, '0')}:${String(endMin).padStart(2, '0')}`;
    document.getElementById('availabilityHours').textContent = `${startStr} - ${endStr}`;

    const durationMinutes = availabilityData.meetingDuration;
    let durationText = '';
    if (durationMinutes >= 60) {
      const h = Math.floor(durationMinutes / 60);
      const m = durationMinutes % 60;
      durationText = h + ' hora' + (h > 1 ? 's' : '') + (m > 0 ? ' ' + m + ' min' : '');
    } else {
      durationText = durationMinutes + ' minutos';
    }
    document.getElementById('meetingDurationDisplay').textContent = durationText;

    // ========== GENERAR OPCIONES DE HORA ==========
    const dateInput = document.getElementById('dateSelect');
    const hourSelect = document.getElementById('hourSelect');

    // Función para generar opciones de hora según la fecha seleccionada
    function generateHourOptions(selectedDateStr) {
      hourSelect.innerHTML = '<option value="">Selecciona una hora</option>';
      if (!selectedDateStr) return;

      const selectedDate = new Date(selectedDateStr + 'T00:00:00');
      const today = new Date();
      today.setHours(0,0,0,0);
      const isToday = selectedDate.getTime() === today.getTime();

      // Obtener el día de la semana (1=lunes, 7=domingo)
      let dayOfWeek = selectedDate.getDay();
      let ourDay = dayOfWeek === 0 ? 7 : dayOfWeek;
      if (!days.includes(ourDay)) {
        hourSelect.innerHTML = '<option value="">Día no disponible</option>';
        return;
      }

      // Calcular límites
      let minMinutes = availabilityData.workStart;
      let maxMinutes = availabilityData.workEnd - availabilityData.meetingDuration;

      if (isToday) {
        const now = new Date();
        const currentMinutes = now.getHours() * 60 + now.getMinutes();
        // Redondear al próximo bloque de 15 minutos
        const roundedMinutes = Math.ceil(currentMinutes / 15) * 15;
        if (roundedMinutes > minMinutes) minMinutes = roundedMinutes;
      }

      // Generar opciones cada 15 minutos
      const step = 15;
      for (let m = minMinutes; m <= maxMinutes; m += step) {
        const h = Math.floor(m / 60);
        const min = m % 60;
        const timeStr = `${String(h).padStart(2, '0')}:${String(min).padStart(2, '0')}`;
        const option = document.createElement('option');
        option.value = timeStr;
        option.textContent = timeStr;
        hourSelect.appendChild(option);
      }

      if (hourSelect.options.length === 1) {
        hourSelect.innerHTML = '<option value="">No hay horarios disponibles</option>';
      }
    }

    // Evento al cambiar la fecha
    dateInput.addEventListener('change', function() {
      generateHourOptions(this.value);
    });

    // Restringir días disponibles en el input date
    function getNextAllowedDate() {
      const today = new Date();
      today.setHours(0,0,0,0);
      let date = new Date(today);
      let attempts = 0;
      while (attempts < 30) {
        let dayOfWeek = date.getDay();
        let ourDay = dayOfWeek === 0 ? 7 : dayOfWeek;
        if (days.includes(ourDay)) return date;
        date.setDate(date.getDate() + 1);
        attempts++;
      }
      return null;
    }

    const minDate = getNextAllowedDate();
    if (minDate) {
      const minStr = minDate.toISOString().split('T')[0];
      dateInput.min = minStr;
    }

    const maxDate = new Date();
    maxDate.setDate(maxDate.getDate() + 30);
    const maxStr = maxDate.toISOString().split('T')[0];
    dateInput.max = maxStr;

    // Si hay un valor previo (eventData), establecerlo
    <% if (locals.eventData && eventData.date) { %>
      dateInput.value = '<%= eventData.date %>';
      generateHourOptions(dateInput.value);
      <% if (locals.eventData && eventData.hour) { %>
        hourSelect.value = '<%= eventData.hour %>';
      <% } %>
    <% } else { %>
      // Establecer la fecha mínima por defecto
      if (minDate) {
        dateInput.value = minDate.toISOString().split('T')[0];
        generateHourOptions(dateInput.value);
      }
    <% } %>

    // Validar al enviar
    document.getElementById('inviteForm').addEventListener('submit', function(e) {
      const date = dateInput.value;
      const hour = hourSelect.value;
      if (!date || !hour) {
        alert('Por favor, selecciona una fecha y una hora.');
        e.preventDefault();
        return;
      }
      // Crear el campo start en el formato esperado por el servidor (YYYY-MM-DDTHH:mm)
      const startField = document.createElement('input');
      startField.type = 'hidden';
      startField.name = 'start';
      startField.value = date + 'T' + hour + ':00';
      this.appendChild(startField);

      // Eliminar los campos date y hour para que no se envíen
      dateInput.removeAttribute('name');
      hourSelect.removeAttribute('name');

      // El servidor espera 'start', no 'date' ni 'hour'
    });
  </script>
</body>
</html>
