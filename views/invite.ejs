<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Agendar evento</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background-color: #f8f9fa; }
    .card { max-width: 700px; margin: 2rem auto; }
    
    /* Calendario con Grid CSS (7 columnas fijas) */
    .calendar-grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 4px;
      margin-top: 8px;
    }
    .calendar-grid .day-cell {
      width: 100%;
      aspect-ratio: 1/1;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      cursor: pointer;
      transition: all 0.2s;
      font-size: 0.9rem;
      background-color: #e9ecef;
      user-select: none;
    }
    .calendar-grid .day-cell:hover:not(.disabled) { background-color: #dee2e6; }
    .calendar-grid .day-cell.selected { background-color: #0d6efd; color: #fff; }
    .calendar-grid .day-cell.has-availability { background-color: #d1e7dd; }
    .calendar-grid .day-cell.has-availability.selected { background-color: #0d6efd; color: #fff; }
    .calendar-grid .day-cell.disabled { opacity: 0.4; cursor: not-allowed; }
    .calendar-grid .day-cell.other-month { opacity: 0.3; }
    
    /* Navegación del mes */
    .month-nav { cursor: pointer; user-select: none; font-size: 1.2rem; }
    .month-nav:hover { color: #0d6efd; }
    
    /* Bloques */
    .block-btn {
      margin: 4px;
      min-width: 80px;
    }
    .block-btn.selected {
      background-color: #0d6efd;
      color: #fff;
      border-color: #0d6efd;
    }
    .block-btn.block-passed {
      opacity: 0.5;
      text-decoration: line-through;
    }
    .block-btn.disabled {
      cursor: not-allowed;
    }

    /* Encabezados de días (Lu, Ma, ...) */
    .day-header {
      text-align: center;
      font-size: 0.8rem;
      font-weight: bold;
      color: #6c757d;
      padding: 4px 0;
    }

    /* Contenedor del calendario */
    .calendar-wrapper {
      max-width: 100%;
      margin: 0 auto;
    }

    /* Para pantallas pequeñas */
    @media (max-width: 576px) {
      .calendar-grid .day-cell {
        font-size: 0.7rem;
      }
      .block-btn {
        min-width: 60px;
        font-size: 0.8rem;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="card shadow p-4">
      <h2 class="text-center mb-4">📅 Agendar reunión</h2>
      <p class="text-muted text-center">Selecciona un día y luego elige un bloque horario disponible.</p>

      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <!-- ========== CALENDARIO MENSUAL (Grid CSS) ========== -->
      <div class="calendar-wrapper">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="month-nav" id="prevMonth">‹</span>
          <h5 class="m-0" id="currentMonthLabel"></h5>
          <span class="month-nav" id="nextMonth">›</span>
        </div>

        <!-- Encabezados de días -->
        <div class="day-header-grid" style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; margin-bottom: 4px;">
          <div class="day-header">Lu</div>
          <div class="day-header">Ma</div>
          <div class="day-header">Mi</div>
          <div class="day-header">Ju</div>
          <div class="day-header">Vi</div>
          <div class="day-header">Sá</div>
          <div class="day-header">Do</div>
        </div>

        <!-- Grid de días -->
        <div id="calendarGrid" class="calendar-grid"></div>
      </div>

      <!-- ========== BLOQUES DISPONIBLES ========== -->
      <div id="blocksContainer" style="display:none;">
        <hr />
        <h6>Bloques disponibles para el <span id="selectedDateLabel"></span></h6>
        <div id="blocksList" class="d-flex flex-wrap justify-content-center"></div>
      </div>

      <!-- ========== FORMULARIO ========== -->
      <form method="POST" action="" id="inviteForm">
        <input type="hidden" name="date" id="selectedDateInput">
        <input type="hidden" name="blockId" id="selectedBlockInput">

        <div class="mb-3">
          <label for="title" class="form-label">Título *</label>
          <input type="text" class="form-control" id="title" name="title" required
                 value="<%= locals.eventData ? eventData.title : '' %>">
        </div>

        <div class="mb-3">
          <label for="description" class="form-label">Descripción</label>
          <textarea class="form-control" id="description" name="description" rows="2"><%= locals.eventData ? eventData.description : '' %></textarea>
        </div>

        <button type="submit" class="btn btn-primary w-100" id="submitBtn" disabled>Enviar solicitud</button>
      </form>

      <p class="mt-3 text-center text-muted small">Este enlace caduca en 24 horas.</p>
    </div>
  </div>

  <script>
    // Datos del servidor
    const blocksByDay = <%- JSON.stringify(blocksByDay) %>;
    const meetingDuration = <%= meetingDuration %>;
    const timeFormat = '24';

    // Estado
    let currentDate = new Date();
    let selectedDate = null;
    let selectedBlockId = null;

    // Referencias DOM
    const calendarGrid = document.getElementById('calendarGrid');
    const currentMonthLabel = document.getElementById('currentMonthLabel');
    const blocksContainer = document.getElementById('blocksContainer');
    const blocksList = document.getElementById('blocksList');
    const selectedDateLabel = document.getElementById('selectedDateLabel');
    const selectedDateInput = document.getElementById('selectedDateInput');
    const selectedBlockInput = document.getElementById('selectedBlockInput');
    const submitBtn = document.getElementById('submitBtn');

    // Función para saber si un día tiene bloques disponibles (futuros)
    function hasAvailableBlocks(date) {
      const dayOfWeek = date.getDay(); // 0=domingo, 1=lunes...
      let ourDay = dayOfWeek === 0 ? 7 : dayOfWeek;
      const blocks = blocksByDay[ourDay] || [];
      if (blocks.length === 0) return false;

      const today = new Date();
      const todayStr = today.toISOString().split('T')[0];
      const dateStr = date.toISOString().split('T')[0];
      const currentMinutes = today.getHours() * 60 + today.getMinutes();

      return blocks.some(block => {
        if (dateStr === todayStr) {
          return block.end_minutes > currentMinutes && (block.end_minutes - block.start_minutes) >= meetingDuration;
        }
        return true;
      });
    }

    // Renderizar calendario usando Grid CSS
    function renderCalendar(year, month) {
      const firstDay = new Date(year, month, 1);
      const lastDay = new Date(year, month + 1, 0);
      const daysInMonth = lastDay.getDate();
      const startDayOfWeek = firstDay.getDay(); // 0=domingo
      // Ajustar para que lunes sea 0
      let startOffset = startDayOfWeek === 0 ? 6 : startDayOfWeek - 1;

      const today = new Date();
      const todayStr = today.toISOString().split('T')[0];

      // Generar celdas
      let cells = [];

      // Días vacíos al inicio
      for (let i = 0; i < startOffset; i++) {
        cells.push({ empty: true });
      }

      // Días del mes
      for (let day = 1; day <= daysInMonth; day++) {
        const dateObj = new Date(year, month, day);
        const dateStr = dateObj.toISOString().split('T')[0];
        const isToday = dateStr === todayStr;
        const hasAvail = hasAvailableBlocks(dateObj);
        const isPast = dateObj < new Date(todayStr);

        let classes = 'day-cell';
        if (isPast) classes += ' disabled';
        else if (!hasAvail) classes += ' disabled';
        else if (hasAvail) classes += ' has-availability';
        if (selectedDate && dateStr === selectedDate) classes += ' selected';

        cells.push({
          day: day,
          dateStr: dateStr,
          classes: classes,
          disabled: isPast || !hasAvail,
          hasAvailability: hasAvail
        });
      }

      // No necesitamos completar filas, grid lo hace automáticamente.

      // Construir HTML
      let html = '';
      cells.forEach(cell => {
        if (cell.empty) {
          html += `<div class="day-cell disabled" style="background:transparent;"></div>`;
        } else {
          html += `<div class="${cell.classes}" data-date="${cell.dateStr}" data-day="${cell.day}">${cell.day}</div>`;
        }
      });

      calendarGrid.innerHTML = html;
      currentMonthLabel.textContent = firstDay.toLocaleString('es', { month: 'long', year: 'numeric' });

      // Event listeners para los días
      document.querySelectorAll('.day-cell:not(.disabled)').forEach(el => {
        el.addEventListener('click', function() {
          const dateStr = this.dataset.date;
          if (dateStr) {
            selectedDate = dateStr;
            selectedDateInput.value = dateStr;
            selectedBlockId = null;
            selectedBlockInput.value = '';
            submitBtn.disabled = true;
            renderCalendar(year, month);
            showBlocksForDate(dateStr);
          }
        });
      });
    }

    // Mostrar bloques para una fecha
    function showBlocksForDate(dateStr) {
      const dateObj = new Date(dateStr + 'T00:00:00');
      const dayOfWeek = dateObj.getDay();
      let ourDay = dayOfWeek === 0 ? 7 : dayOfWeek;
      const blocks = blocksByDay[ourDay] || [];

      if (blocks.length === 0) {
        blocksContainer.style.display = 'none';
        return;
      }

      blocksContainer.style.display = 'block';
      selectedDateLabel.textContent = dateObj.toLocaleDateString('es', { weekday: 'long', day: 'numeric', month: 'long' });

      // Ordenar por hora
      blocks.sort((a, b) => a.start_minutes - b.start_minutes);

      const today = new Date();
      const todayStr = today.toISOString().split('T')[0];
      const currentMinutes = today.getHours() * 60 + today.getMinutes();

      let html = '';
      blocks.forEach(block => {
        const startTime = formatTime(block.start_minutes);
        const endTime = formatTime(block.end_minutes);
        const blockDuration = block.end_minutes - block.start_minutes;
        const isDurationValid = blockDuration >= meetingDuration;
        const isPast = (dateStr === todayStr) && (block.end_minutes <= currentMinutes);
        let canFit = true;
        if (dateStr === todayStr && !isPast) {
          const remainingMinutes = block.end_minutes - currentMinutes;
          canFit = remainingMinutes >= meetingDuration;
        }
        const isSelected = selectedBlockId === block.id;
        const disabled = !isDurationValid || isPast || !canFit;
        let btnClass = 'block-btn btn btn-sm ';
        if (isSelected) {
          btnClass += 'btn-primary selected';
        } else if (disabled) {
          btnClass += 'btn-secondary block-passed';
        } else {
          btnClass += 'btn-outline-primary';
        }

        html += `
          <button class="${btnClass}" data-block-id="${block.id}" ${disabled ? 'disabled' : ''}>
            ${startTime} - ${endTime}
          </button>
        `;
      });

      blocksList.innerHTML = html;

      // Event listeners para los bloques
      document.querySelectorAll('.block-btn:not(:disabled)').forEach(btn => {
        btn.addEventListener('click', function() {
          const blockId = parseInt(this.dataset.blockId);
          if (blockId) {
            selectedBlockId = blockId;
            selectedBlockInput.value = blockId;
            submitBtn.disabled = false;
            document.querySelectorAll('.block-btn').forEach(b => b.classList.remove('selected', 'btn-primary'));
            this.classList.add('selected', 'btn-primary');
          }
        });
      });
    }

    // Formatear minutos a hora
    function formatTime(minutes) {
      const h = Math.floor(minutes / 60);
      const m = minutes % 60;
      if (timeFormat === '12') {
        const ampm = h >= 12 ? 'PM' : 'AM';
        const h12 = h % 12 || 12;
        return `${String(h12).padStart(2, '0')}:${String(m).padStart(2, '0')} ${ampm}`;
      }
      return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
    }

    // Navegación meses
    document.getElementById('prevMonth').addEventListener('click', function() {
      currentDate.setMonth(currentDate.getMonth() - 1);
      renderCalendar(currentDate.getFullYear(), currentDate.getMonth());
    });
    document.getElementById('nextMonth').addEventListener('click', function() {
      currentDate.setMonth(currentDate.getMonth() + 1);
      renderCalendar(currentDate.getFullYear(), currentDate.getMonth());
    });

    // Validación al enviar
    document.getElementById('inviteForm').addEventListener('submit', function(e) {
      if (!selectedDate || !selectedBlockId) {
        alert('Por favor, selecciona un día y un bloque horario.');
        e.preventDefault();
        return;
      }
    });

    // Inicializar
    renderCalendar(currentDate.getFullYear(), currentDate.getMonth());

    // Si hay datos previos (error), restaurar selección
    <% if (locals.eventData && eventData.date && eventData.blockId) { %>
      const prevDate = '<%= eventData.date %>';
      const prevBlockId = parseInt('<%= eventData.blockId %>');
      selectedDate = prevDate;
      selectedDateInput.value = prevDate;
      selectedBlockId = prevBlockId;
      selectedBlockInput.value = prevBlockId;
      submitBtn.disabled = false;
      renderCalendar(currentDate.getFullYear(), currentDate.getMonth());
      showBlocksForDate(prevDate);
      setTimeout(() => {
        document.querySelectorAll('.block-btn').forEach(btn => {
          if (parseInt(btn.dataset.blockId) === prevBlockId) {
            btn.click();
          }
        });
      }, 100);
    <% } %>
  </script>
</body>
</html>
