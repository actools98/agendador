<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Mi Calendario</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <!-- Estilos personalizados -->
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="bg-dark text-light">

<div class="container-fluid vh-100 d-flex flex-column p-0">
  <div class="row flex-grow-1 g-0">

    <!-- ========== COLUMNA IZQUIERDA ========== -->
    <div class="col-12 col-md-3 col-lg-2 sidebar p-3">
      <h4 class="mb-4">📅 Calendario</h4>
      <p class="text-muted small">Bienvenido, <strong><%= username %></strong></p>
      <hr class="border-light" />
      <button id="newEventBtn" class="btn btn-primary w-100 mb-3">+ Nuevo evento</button>
      
      <!-- Botón para eventos terminados -->
      <button id="toggleFinishedBtn" class="btn btn-outline-secondary w-100 mb-2">📋 Eventos terminados</button>
      <!-- Lista de eventos terminados (oculta por defecto) -->
      <div id="finishedEventsList" class="list-group list-group-flush mt-2" style="display:none;"></div>

      <h6 class="mt-3">Mis eventos activos</h6>
      <div id="eventList" class="list-group list-group-flush mt-2"></div>
      <hr class="border-light" />
      <button id="settingsBtn" class="btn btn-outline-secondary w-100 mb-3">⚙️ Configuración</button>
      <a href="/logout" class="btn btn-outline-danger w-100">Cerrar sesión</a>
    </div>

    <!-- ========== COLUMNA DERECHA (CALENDARIO) ========== -->
    <div class="col-12 col-md-9 col-lg-10 p-3 calendar-container">
      <!-- Cabecera con controles -->
      <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
        <div>
          <button id="prevView" class="btn btn-secondary">‹</button>
          <button id="nextView" class="btn btn-secondary">›</button>
          <span id="viewTitle" class="ms-2 h5 mb-0"></span>
        </div>
        <div class="btn-group" role="group" aria-label="Vistas">
          <button class="btn btn-outline-primary view-btn" data-view="day">Día</button>
          <button class="btn btn-outline-primary view-btn" data-view="week">Semana</button>
          <button class="btn btn-outline-primary view-btn active" data-view="month">Mes</button>
          <button class="btn btn-outline-primary view-btn" data-view="year">Año</button>
        </div>
      </div>
      <!-- Grid del calendario -->
      <div id="calendarGrid" class="calendar-grid"></div>
      <!-- Mensaje de depuración -->
      <div id="debug-message" style="color: #88aadd; font-size: 0.9rem; text-align: center; margin-top: 10px;">
        ✅ Calendario cargado
      </div>
    </div>

  </div>
</div>

<!-- ========== MODAL PARA EVENTOS ========== -->
<div class="modal fade" id="eventModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content bg-dark text-light border-0">
      <div class="modal-header border-secondary">
        <h5 class="modal-title" id="modalTitle">Evento</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="eventForm">
          <input type="hidden" id="eventId" />
          <div class="mb-3">
            <label for="title" class="form-label">Título *</label>
            <input type="text" class="form-control bg-dark text-light border-secondary" id="title" required />
          </div>
          <div class="mb-3">
            <label for="description" class="form-label">Descripción</label>
            <textarea class="form-control bg-dark text-light border-secondary" id="description" rows="2"></textarea>
          </div>
          <div class="row">
            <div class="col-6 mb-3">
              <label for="start" class="form-label">Inicio *</label>
              <input type="datetime-local" class="form-control bg-dark text-light border-secondary" id="start" required />
            </div>
            <div class="col-6 mb-3">
              <label for="end" class="form-label">Fin *</label>
              <input type="datetime-local" class="form-control bg-dark text-light border-secondary" id="end" required />
            </div>
          </div>
          <div class="mb-3 form-check">
            <input type="checkbox" class="form-check-input" id="allDay" />
            <label class="form-check-label" for="allDay">Todo el día</label>
          </div>
          <div class="mb-3">
            <label for="color" class="form-label">Color</label>
            <input type="color" class="form-control form-control-color bg-dark border-secondary" id="color" value="#3788d8" />
          </div>
          <!-- Selector de estado -->
          <div class="mb-3">
            <label for="eventStatus" class="form-label">Estado</label>
            <select id="eventStatus" class="form-select bg-dark text-light border-secondary">
              <option value="active">Activo</option>
              <option value="completed">Completado</option>
              <option value="postponed">Pospuesto</option>
              <option value="cancelled">Cancelado</option>
            </select>
          </div>
        </form>
      </div>
      <div class="modal-footer border-secondary">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" id="deleteEventBtn" class="btn btn-danger me-auto" style="display:none;">Eliminar</button>
        <button type="button" id="saveEventBtn" class="btn btn-primary">Guardar</button>
      </div>
    </div>
  </div>
</div>

<!-- ========== MODAL DE CONFIGURACIÓN (CON FRANJA HORARIA) ========== -->
<div class="modal fade" id="settingsModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content bg-dark text-light border-0">
      <div class="modal-header border-secondary">
        <h5 class="modal-title">⚙️ Configuración</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <!-- Formato de hora -->
        <div class="mb-3">
          <label for="timeFormatSelect" class="form-label">Formato de hora</label>
          <select id="timeFormatSelect" class="form-select bg-dark text-light border-secondary">
            <option value="24">24h (00:00 - 23:59)</option>
            <option value="12">12h (AM/PM)</option>
          </select>
        </div>
        <hr class="border-secondary" />
        <!-- Franja horaria laboral -->
        <div class="mb-3">
          <label class="form-label">Franja horaria laboral</label>
          <div class="row">
            <div class="col-6">
              <label for="workStart" class="form-label small">Inicio</label>
              <input type="number" id="workStart" class="form-control bg-dark text-light border-secondary" min="0" max="23" value="8" />
            </div>
            <div class="col-6">
              <label for="workEnd" class="form-label small">Fin</label>
              <input type="number" id="workEnd" class="form-control bg-dark text-light border-secondary" min="0" max="23" value="17" />
            </div>
          </div>
          <div class="text-muted small mt-1">El calendario se enfocará automáticamente en esta franja.</div>
        </div>
      </div>
      <div class="modal-footer border-secondary">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

<!-- ========== SCRIPTS ========== -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/app.js"></script>
</body>
</html>
