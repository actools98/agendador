<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Mi Calendario</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

<div class="container-fluid p-0 vh-100 d-flex flex-column">

  <!-- ========== CABECERA SUPERIOR ========== -->
  <div class="mobile-header d-flex align-items-center justify-content-between px-3 py-2">
    <h5 class="m-0" id="headerTitle">📅 Calendario</h5>
    <div class="d-flex align-items-center gap-2">
      <button id="menuToggle" class="btn btn-outline-secondary btn-sm d-md-none" aria-label="Menú">
        ☰
      </button>
    </div>
  </div>

  <!-- ========== CONTENIDO PRINCIPAL ========== -->
  <div class="main-content flex-grow-1 overflow-hidden">

    <div class="row g-0 h-100">

      <!-- ========== COLUMNA IZQUIERDA (SIDEBAR) ========== -->
      <div class="col-12 col-md-3 col-lg-2 sidebar p-3" id="sidebarDesktop">
        <div class="d-none d-md-block">
          <h4 class="mb-4">📅 Calendario</h4>
          <p class="text-muted small">Bienvenido, <strong><%= username %></strong></p>
          <hr class="border-secondary" />
        </div>

        <div class="d-grid gap-2">
          <button id="newEventBtnDesktop" class="btn btn-primary w-100 mb-2">+ Nuevo evento</button>
          <button id="toggleFinishedBtnDesktop" class="btn btn-outline-secondary w-100 mb-2">📋 Eventos terminados</button>
        </div>

        <div id="finishedEventsList" class="list-group list-group-flush mt-2" style="display:none;"></div>

        <h6 class="mt-3">Mis eventos activos</h6>
        <div id="eventList" class="list-group list-group-flush mt-2"></div>

        <hr class="border-secondary" />
        <button id="categoriasBtnDesktop" class="btn btn-outline-secondary w-100 mb-2">🏷️ Categorías</button>
        <button id="settingsBtnDesktop" class="btn btn-outline-secondary w-100 mb-3">⚙️ Configuración</button>
        <a href="/logout" class="btn btn-outline-danger w-100">Cerrar sesión</a>
      </div>

      <!-- ========== COLUMNA DERECHA (CALENDARIO) ========== -->
      <div class="col-12 col-md-9 col-lg-10 p-3 calendar-container" id="calendarContainer">
        <!-- Controles de navegación -->
        <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
          <div class="d-flex align-items-center gap-2">
            <button id="prevView" class="btn btn-secondary btn-sm">‹</button>
            <button id="nextView" class="btn btn-secondary btn-sm">›</button>
            <span id="viewTitle" class="ms-1 h5 mb-0"></span>
          </div>
          <div class="btn-group btn-group-sm" role="group" aria-label="Vistas">
            <button class="btn btn-outline-primary view-btn" data-view="day">Día</button>
            <button class="btn btn-outline-primary view-btn" data-view="week">Semana</button>
            <button class="btn btn-outline-primary view-btn active" data-view="month">Mes</button>
            <button class="btn btn-outline-primary view-btn" data-view="year">Año</button>
          </div>
        </div>

        <!-- Grid del calendario -->
        <div id="calendarGrid" class="calendar-grid"></div>

        <!-- Footer -->
        <div id="debug-message" class="debug-message">Powered by actols.com</div>
      </div>

    </div>
  </div>
</div>

<!-- ========== MODAL DE DETALLE DEL EVENTO ========== -->
<div class="modal fade" id="eventDetailModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="detailModalTitle">Detalle del evento</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="detailContent">
          <p><strong>Título:</strong> <span id="detailTitle"></span></p>
          <p><strong>Descripción:</strong> <span id="detailDescription"></span></p>
          <p><strong>Categoría:</strong> <span id="detailCategory"></span></p>
          <p><strong>Estado:</strong> <span id="detailStatus"></span></p>
          <p><strong>Inicio:</strong> <span id="detailStart"></span></p>
          <p><strong>Fin:</strong> <span id="detailEnd"></span></p>
          <p><strong>Todo el día:</strong> <span id="detailAllDay"></span></p>
          <p><strong>Enlace:</strong> <span id="detailLink"></span></p>
          <p><strong>Dirección:</strong> <span id="detailAddress"></span></p>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
        <button type="button" id="editFromDetailBtn" class="btn btn-primary btn-sm">Editar</button>
      </div>
    </div>
  </div>
</div>

<!-- ========== MODAL DE EDICIÓN/CREACIÓN DE EVENTO (MEJORADO) ========== -->
<div class="modal fade" id="eventModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modalTitle">Evento</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="eventForm">
          <input type="hidden" id="eventId" />
          <div class="row g-2">
            <div class="col-12">
              <label for="title" class="form-label">Título *</label>
              <input type="text" class="form-control" id="title" required />
            </div>
          </div>
          <div class="row g-2 mt-1">
            <div class="col-12">
              <label for="description" class="form-label">Descripción</label>
              <textarea class="form-control" id="description" rows="2"></textarea>
            </div>
          </div>
          <div class="row g-2 mt-1">
            <div class="col-md-6">
              <label for="start" class="form-label">Inicio *</label>
              <input type="datetime-local" class="form-control" id="start" required />
            </div>
            <div class="col-md-6">
              <label for="end" class="form-label">Fin *</label>
              <input type="datetime-local" class="form-control" id="end" required />
            </div>
          </div>
          <div class="row g-2 mt-1">
            <div class="col-md-4">
              <div class="form-check mt-2">
                <input type="checkbox" class="form-check-input" id="allDay" />
                <label class="form-check-label" for="allDay">Todo el día</label>
              </div>
            </div>
            <div class="col-md-4">
              <label for="eventCategoria" class="form-label">Categoría</label>
              <select id="eventCategoria" class="form-select">
                <option value="">Sin categoría</option>
              </select>
            </div>
            <div class="col-md-4">
              <label for="color" class="form-label">Color</label>
              <input type="color" class="form-control form-control-color" id="color" value="#3788d8" />
            </div>
          </div>
          <div class="row g-2 mt-1">
            <div class="col-md-6">
              <label for="eventStatus" class="form-label">Estado</label>
              <select id="eventStatus" class="form-select">
                <option value="active">Activo</option>
                <option value="completed">Completado</option>
                <option value="postponed">Pospuesto</option>
                <option value="cancelled">Cancelado</option>
              </select>
            </div>
            <div class="col-md-6">
              <label for="eventLink" class="form-label">Enlace (URL)</label>
              <input type="url" class="form-control" id="eventLink" placeholder="https://..." />
            </div>
          </div>
          <div class="row g-2 mt-1">
            <div class="col-12">
              <label for="eventAddress" class="form-label">Dirección</label>
              <input type="text" class="form-control" id="eventAddress" placeholder="Calle, ciudad, etc." />
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" id="deleteEventBtn" class="btn btn-danger btn-sm me-auto" style="display:none;">Eliminar</button>
        <button type="button" id="saveEventBtn" class="btn btn-primary btn-sm">Guardar</button>
      </div>
    </div>
  </div>
</div>

<!-- ========== MODAL DE CATEGORÍAS ========== -->
<div class="modal fade" id="categoriasModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">🏷️ Categorías</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="categoriasList" class="list-group list-group-flush mb-3"></div>
        <form id="categoriaForm">
          <input type="hidden" id="categoriaEditId" />
          <div class="row g-2">
            <div class="col-7">
              <input type="text" id="categoriaNombre" class="form-control form-control-sm" placeholder="Nombre" required />
            </div>
            <div class="col-3">
              <input type="color" id="categoriaColor" class="form-control form-control-color form-control-sm" value="#6c757d" />
            </div>
            <div class="col-2">
              <button type="submit" id="categoriaSaveBtn" class="btn btn-primary btn-sm w-100">Guardar</button>
            </div>
          </div>
        </form>
        <div id="categoriaError" class="text-danger small mt-1" style="display:none;"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

<!-- ========== MODAL DE CONFIGURACIÓN ========== -->
<div class="modal fade" id="settingsModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">⚙️ Configuración</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="mb-2">
          <label for="timeFormatSelect" class="form-label small">Formato de hora</label>
          <select id="timeFormatSelect" class="form-select form-select-sm">
            <option value="24">24h (00:00 – 23:59)</option>
            <option value="12">12h (AM/PM)</option>
          </select>
        </div>
        <div class="mb-2">
          <label for="themeSelect" class="form-label small">Tema</label>
          <select id="themeSelect" class="form-select form-select-sm">
            <option value="claro">Claro</option>
            <option value="oscuro">Oscuro</option>
          </select>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
        <button type="button" id="saveSettingsBtn" class="btn btn-primary btn-sm">Guardar cambios</button>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/app.js"></script>
</body>
</html>
